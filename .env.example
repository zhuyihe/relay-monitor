# MySQL 连接（外部实例，必填）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=relay
DB_PASSWORD=
DB_NAME=relay_monitor

# 登录信息加密密钥（强烈建议配）：32 字节 base64，用 openssl rand -base64 32 生成。
# 配上后，上游的令牌、密码和通知方式的密钥加密保存；不配就明文保存，启动日志会提醒。
# 密钥要和数据库备份分开保存：丢了就解不开，只能用 node db/reset-secrets.js 清掉后重新填（见 deploy/README.md）
RELAY_SECRET_KEY=
# 也可以把密钥写在文件里、指向这个文件（两者只配一个）
# RELAY_SECRET_KEY_FILE=/run/secrets/relay_secret_key

# v1 数据一次性迁移来源（可选）：指向 v1 的 data 目录，表为空时自动导入
V1_DATA_DIR=./data
